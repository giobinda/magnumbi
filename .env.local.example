# Copy to .env.local (git-ignored) and fill in. Loaded by the Makefile targets.

# Who runs the platform until organisations are saved for the first time (comma-separated emails).
# Give them a password with: make user EMAIL=you@example.com
MAGNUM_SYSTEM_OWNERS=

# Encrypts each organisation's ScramDB connection string in the primary database. Required for
# organisation databases. Create it once with `make key` (or `magnum-bi gen-key`) and keep it:
# every replica needs the same key, and losing it means re-entering the connection strings.
MAGNUM_SECRET_KEY=

# Keep usage metrics this many days (default 400)
# MAGNUM_USAGE_RETENTION_DAYS=400
# MAGNUM_CACHE_MAX_ROWS=5000000

# The primary ScramDB (default: the dev container from `make db-up`)
# MAGNUM_DATABASE_URL=postgresql://scramdb@127.0.0.1:55432/scramdb

# Optional: Google sign-in, next to passwords. Create an OAuth client in Google Cloud Console:
#   APIs & Services > Credentials > Create credentials > OAuth client ID > Web application
#   Authorized redirect URIs:
#     http://localhost:5173/api/auth/google/callback   (Vite dev server)
#     http://localhost:8000/api/auth/google/callback   (server with the built UI)
# MAGNUM_GOOGLE_CLIENT_ID=
# MAGNUM_GOOGLE_CLIENT_SECRET=
# Only show accounts of this Google Workspace in Google's picker (access is still decided by
# Magnum BI's organisations and members)
# MAGNUM_GOOGLE_HD=

# Turn off password sign-in (Google only)
# MAGNUM_PASSWORD_LOGIN=0

# DuckDB connections read files from one directory per organisation (default data/duckdb)
# MAGNUM_DUCKDB_DIR=data/duckdb
# Allow downloading DuckDB's httpfs (object storage), avro and iceberg extensions on first use (default 1)
# MAGNUM_DUCKDB_INSTALL_EXTENSIONS=1
